# ShramSetu Node API — environment
# Copy to .env for local dev. NEVER commit the real .env.

# "memory" = embedded MongoDB for development (no install needed).
# Production: mongodb://user:pass@host:27017/shramsetu
MONGODB_URI=memory

# Set a long random string in production (otherwise tokens die on restart).
JWT_SECRET_KEY=
JWT_EXPIRES_IN=7d

# Government portal bootstrap admin (created/repaired at server start).
BOOTSTRAP_ADMIN_EMPLOYEE_ID=ADMIN001
BOOTSTRAP_ADMIN_PASSWORD=Admin@123

# DEV ONLY: echo OTP back in API responses so the UI can auto-fill
# (the code always prints to the backend terminal). Hard-disable in prod.
OTP_ECHO_ENABLED=true
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Key for the stored OTP digests (HMAC-SHA256). Required in production, at
# least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=

SEED_DEMO_DATA=true

PORT=8000
# ENV defaults to production. development is the ONLY value that switches off
# the startup safety checks and enables the demo conveniences below.
ENV=development
DEBUG=true

# Express `trust proxy` (how many reverse proxies sit in front of the API).
# Defaults to 1 in production, off otherwise. Use 0 when the app is exposed
# directly; never `true` (a client could forge X-Forwarded-For).
# TRUST_PROXY=1

# Python AI microservice (RAG + Whisper STT + Coqui TTS)
AI_SERVICE_URL=http://127.0.0.1:8100
# Budget for one Node->AI call. Warm /ask answers in ~1-2s; the first one after
# a restart can legitimately spend a minute loading embeddings + FAISS (and the
# Whisper model) on a small box. The AI service prewarms RAG at boot to avoid
# this, but 60s aborted slow first requests mid-load and surfaced as
# "ai-service unavailable: This operation was aborted".
AI_TIMEOUT_MS=120000
# Shared secret sent as X-Internal-Key. Leave empty only if the AI service's
# own AI_INTERNAL_KEY is also empty (dev only).
AI_INTERNAL_KEY=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Document-wallet master key: 32 bytes, base64. Wraps the per-file AES keys
# (each file is encrypted with AES-256-GCM under its own key; that key is
# wrapped under this one). PRODUCTION REFUSES TO BOOT without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOC_MASTER_KEY=

# Rate limits — requests allowed per RATE_LIMIT_WINDOW_MS window.
# The OTP and login caps are the abuse-relevant ones; raise them only for
# load testing, never in production.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API=300
RATE_LIMIT_OTP_REQUEST=5
RATE_LIMIT_OTP_VERIFY=10
RATE_LIMIT_WORKER_LOGIN=10
RATE_LIMIT_GOV_LOGIN=10
RATE_LIMIT_REGISTER=5

CORS_ORIGINS=http://localhost:5173,http://localhost:5199

# ── DEV SEED ACCOUNTS — development fixtures, never production accounts ──────
# Created only when SEED_DEMO_DATA=true (which production refuses to boot with),
# from server/src/seed/seed.js. This comment block is the single place these
# logins are written down; README.md and DEMO.md point here instead of copying
# the table, so a scraper cannot lift a working login out of the docs.
#
#   Government portal (employee ID / password)
#     ADMIN001 / Admin@123        superadmin — every state + audit logs
#     KL001    / Kerala@123       state official — Kerala only
#     EKM001   / Ernakulam@123    district official — Ernakulam only
#
#   Workers (/worker/login, password tab). Mobiles 9555500101 … 9555500110,
#   password Worker@123. The OTP tab also works for any seeded mobile; the code
#   is printed to the server terminal only (never returned by the API once
#   OTP_ECHO_ENABLED=false).
#
#   Employer  (/employer/login)           9000000021 / Employer@123
#                                          (labour-office accepted, 1 listing)
#   Household (/citizen/login, password)  9000000022 / Household@123
#
# DEV ONLY: BOOTSTRAP_ADMIN_PASSWORD=Admin@123 above is the same kind of
# fixture. assertProductionSafe() refuses to start with it in production.
