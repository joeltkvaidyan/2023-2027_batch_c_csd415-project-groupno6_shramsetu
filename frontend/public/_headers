# Security headers for static hosts (Render Static Sites, Cloudflare Pages,
# Netlify). nginx deployments get the equivalent set from frontend/nginx.conf.
#
# connect-src lists the API origin because a static host serves the SPA and the
# API separately (no /api proxy), so every fetch is cross-origin. Keep this in
# step with VITE_API_BASE_URL in render.yaml if the API host changes.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://shramsetu-api.onrender.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()

# Fingerprinted assets are immutable; the shell must revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate
