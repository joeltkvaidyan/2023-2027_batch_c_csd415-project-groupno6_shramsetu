{
  "$comment": "Single source of truth for the semantic colour layer. scripts/check-contrast.mjs reads this file, asserts frontend/src/design/tokens.css declares exactly these values for every theme, and computes WCAG 2.1 contrast for every pair below — CI fails if a text pair drops under 4.5:1 or a UI pair under 3:1. Nothing here is decorative: each pair is a combination the app actually renders.",
  "themes": {
    "light": {
      "surface": "#fffcf7",
      "surfaceRaised": "#f7f0e4",
      "surfaceSunken": "#efe5d5",
      "textPrimary": "#231a14",
      "textSecondary": "#574639",
      "textMuted": "#6a5646",
      "border": "#dfd2be",
      "borderStrong": "#7c6a57",
      "brand": "#7e3213",
      "brandHover": "#65280f",
      "onBrand": "#fff8f1",
      "danger": "#a32020",
      "onDanger": "#ffffff",
      "success": "#2e6b2f",
      "onSuccess": "#ffffff",
      "warning": "#8a5a00",
      "onWarning": "#ffffff",
      "focus": "#1e5f8a"
    },
    "dark": {
      "surface": "#17120f",
      "surfaceRaised": "#221b16",
      "surfaceSunken": "#0d0a08",
      "textPrimary": "#f7efe4",
      "textSecondary": "#d8c8b6",
      "textMuted": "#b49f8b",
      "border": "#3a302a",
      "borderStrong": "#a08c77",
      "brand": "#f0a277",
      "brandHover": "#f6bc9a",
      "onBrand": "#2a1207",
      "danger": "#ff9e8a",
      "onDanger": "#2a0505",
      "success": "#96d9a1",
      "onSuccess": "#04220c",
      "warning": "#f5c86b",
      "onWarning": "#2a1a00",
      "focus": "#8cc8f0"
    },
    "highContrast": {
      "surface": "#000000",
      "surfaceRaised": "#0a0a0a",
      "surfaceSunken": "#000000",
      "textPrimary": "#ffffff",
      "textSecondary": "#ffffff",
      "textMuted": "#e5e5e5",
      "border": "#ffffff",
      "borderStrong": "#ffffff",
      "brand": "#ffc48a",
      "brandHover": "#ffd9b5",
      "onBrand": "#000000",
      "danger": "#ff9a9a",
      "onDanger": "#000000",
      "success": "#8dffa8",
      "onSuccess": "#000000",
      "warning": "#ffe066",
      "onWarning": "#000000",
      "focus": "#7dd3fc"
    }
  },
  "pairs": [
    { "fg": "textPrimary", "bg": "surface", "min": 4.5, "use": "body copy, headings" },
    { "fg": "textPrimary", "bg": "surfaceRaised", "min": 4.5, "use": "body copy on cards" },
    { "fg": "textSecondary", "bg": "surface", "min": 4.5, "use": "labels, captions" },
    { "fg": "textSecondary", "bg": "surfaceRaised", "min": 4.5, "use": "labels on cards" },
    { "fg": "textMuted", "bg": "surface", "min": 4.5, "use": "timestamps, helper text" },
    { "fg": "textMuted", "bg": "surfaceRaised", "min": 4.5, "use": "helper text on cards" },
    { "fg": "onBrand", "bg": "brand", "min": 4.5, "use": "primary button label" },
    { "fg": "onBrand", "bg": "brandHover", "min": 4.5, "use": "primary button, hovered" },
    { "fg": "onDanger", "bg": "danger", "min": 4.5, "use": "destructive button label" },
    { "fg": "onSuccess", "bg": "success", "min": 4.5, "use": "success chip label" },
    { "fg": "onWarning", "bg": "warning", "min": 4.5, "use": "warning chip label" },
    { "fg": "danger", "bg": "surface", "min": 4.5, "use": "inline error text" },
    { "fg": "danger", "bg": "surfaceRaised", "min": 4.5, "use": "inline error text on cards" },
    { "fg": "success", "bg": "surface", "min": 4.5, "use": "saved confirmation text" },
    { "fg": "brand", "bg": "surface", "min": 4.5, "use": "links" },
    {
      "fg": "borderStrong",
      "bg": "surface",
      "min": 3,
      "use": "input outline, meaningful dividers"
    },
    { "fg": "focus", "bg": "surface", "min": 3, "use": "keyboard focus ring" },
    { "fg": "focus", "bg": "surfaceRaised", "min": 3, "use": "keyboard focus ring on cards" }
  ]
}
